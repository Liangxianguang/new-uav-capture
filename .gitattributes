# CWM source snapshots are byte-audited; Windows checkout must keep their LF.
/experiments/cwm_v*/**/*.py text eol=lf
/experiments/cwm_v*/**/*protocol*.json text eol=lf

# V20 reports are exact emitted run bytes (including native JSON line endings).
/experiments/cwm_v20/reports/** -text whitespace=cr-at-eol

# V21 includes lossless ZIP chunks and exact emitted research report bytes.
/experiments/cwm_v21/artifacts/*.part* -text
/experiments/cwm_v21/artifacts/*.parts.json -text whitespace=cr-at-eol
/experiments/cwm_v21/reports/** -text whitespace=cr-at-eol

# V22 emitted summaries and full diagnosis archives retain exact evidence bytes.
/experiments/cwm_v22/reports/** -text whitespace=cr-at-eol

# V23 preserves exact emitted scientific evidence and lossless ZIP transport.
/experiments/cwm_v23/reports/** -text whitespace=cr-at-eol
/experiments/cwm_v23/artifacts/*.part* -text
/experiments/cwm_v23/artifacts/*.parts.json -text whitespace=cr-at-eol

# V24 diagnostic evidence also retains exact emitted bytes under Windows.
/experiments/cwm_v24/reports/** -text whitespace=cr-at-eol
/experiments/cwm_v24/artifacts/** -text

# V25 emitted entry replay reports and archive retain exact evidence bytes.
/experiments/cwm_v25/reports/** -text whitespace=cr-at-eol
/experiments/cwm_v25/artifacts/** -text

# V26 complete real-checkpoint shadow evidence retains native emitted bytes.
/experiments/cwm_v26/reports/** -text whitespace=cr-at-eol
/experiments/cwm_v26/artifacts/** -text

# V27 exact emitted candidate replay evidence; preserve native JSON bytes.
/experiments/cwm_v27/reports/** -text whitespace=cr-at-eol
/experiments/cwm_v27/artifacts/** -text

# V28 future data/training reports retain exact native evidence bytes.
/experiments/cwm_v28/reports/** -text whitespace=cr-at-eol
/experiments/cwm_v28/artifacts/** -text

# V29 exact original-entry regression evidence and binary archives.
/experiments/cwm_v29/reports/** -text whitespace=cr-at-eol
/experiments/cwm_v29/artifacts/** -text
