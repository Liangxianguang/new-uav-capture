__pycache__/
.pytest_cache/
*.py[cod]

# Generated experiment artifacts are reproducible locally, not versioned.
results/*
!results/.gitkeep
external/
tmp/
**/tensorboard/
**/tensorboard_hparams/
**/checkpoint*.pt
**/best_checkpoint*.pt
**/last_checkpoint*.pt
*.npz

# Representative release media is the only tracked rendered output.
*.png
!docs/media/*.png
!docs/media/*.gif
!docs/media/*.mp4

# The released development checkpoint is intentionally versioned.
!models/v5_development_exact_reactive_seed661606.pt

# Frozen Phase 2 checkpoints used by the formal prediction comparison.
!models/formal_phase2_v3/
!models/formal_phase2_v3/*.pt
!models/formal_phase2_v3/manifest.json
models/phase15_s4_v3_*/

# Active formal training outputs and local process logs are reproducible
# artifacts; keep checkpoints, TensorBoard files, and progress state out of Git.
models/phase86_pure_mappo_route_nocbf_long_seed101_20260921_v2/
run_logs/phase86_pure_mappo_route_nocbf_long_seed101_20260921_v2.*
